# OpenAQ API v3 Key (obtain free from https://explore.openaq.org/)
OPENAQ_API_KEY=

# Google Gemini API Key (obtain from https://aistudio.google.com/app/api-keys)
GOOGLE_API_KEY=

# Model to use for the Clean Air Investigator (free-tier eligible)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Cloud Project settings for Cloud Run deployment
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
